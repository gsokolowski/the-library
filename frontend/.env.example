# Laravel base URL (SPA calls {VITE_BACKEND_URL}/graphql directly; CORS allows the Vite origin).
# php artisan serve default:
VITE_BACKEND_URL=http://127.0.0.1:8000
# XAMPP example (no trailing slash):
# VITE_BACKEND_URL=http://localhost/tools/the-library/backend/public

# Optional: full GraphQL URL (overrides VITE_BACKEND_URL + /graphql)
# VITE_GRAPHQL_URL=http://127.0.0.1:8000/graphql
